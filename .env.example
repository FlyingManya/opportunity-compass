# Create .env.local and enter credentials locally. Do not commit that file.
MONGODB_URI=
MONGODB_DB=opportunity_compass
APP_ORIGIN=http://127.0.0.1:4180
# Optional direct Meta Model API connection. Never expose this as NEXT_PUBLIC_.
MODEL_API_KEY=
# Direct Meta Model API: enables replies with the documented web_search tool.
META_TEXT_MODEL=muse-spark-1.3
# Alternatively use an OpenAI-compatible host serving a Meta open-weight model.
# Set all three; this path has no built-in search integration yet.
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=
